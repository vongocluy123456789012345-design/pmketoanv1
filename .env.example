# Sao chép file này thành .env rồi điền giá trị thật.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key: CHỈ dùng ở backend chạy local, không đưa lên trình duyệt / git.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=invoices

# --- Cổng hóa đơn điện tử Tổng cục Thuế ---
GDT_BASE_URL=https://hoadondientu.gdt.gov.vn/api
# Đặt false nếu Python báo lỗi chứng chỉ SSL của cổng thuế.
GDT_VERIFY_SSL=true
# Nghỉ giữa các request (giây) để tránh bị chặn.
GDT_REQUEST_DELAY=0.6

# --- Dựng PDF dự phòng từ XML khi không lấy được PDF gốc ---
RENDER_FALLBACK_PDF=true
FALLBACK_FONT=C:/Windows/Fonts/arial.ttf

# --- TConnect Open API (lấy hộ hóa đơn từ cổng thuế) ---
# Đăng ký tại https://tconnect.vn/vi/onboard ; TConnect cấp các giá trị dưới đây.
# Sandbox: https://sme-open-api-sandbox.tconnect.vn  | Production: TConnect cấp sau khi kiểm thử xong.
TCONNECT_AUTH_BASE=https://sme-open-api-sandbox.tconnect.vn
TCONNECT_PARTNER_CODE=
TCONNECT_CLIENT_ID=
TCONNECT_CLIENT_SECRET=
TCONNECT_AES_KEY=
TCONNECT_USERNAME=
TCONNECT_PASSWORD=

APP_HOST=127.0.0.1
APP_PORT=8000

# Tu dong tai qua Chrome
OUTPUT_DIR=
CHROME_PATH=
CHROME_DEBUG_PORT=9333
